# Client-side shadows race destroyed windows on the software-rendering path and
# spam BadDrawable/BadWindow errors. They are cosmetic, so skip the compositor
# when Mesa is explicitly forced to software rendering.
if [ "${LIBGL_ALWAYS_SOFTWARE}" != "true" ]; then
  xcompmgr -c &
fi

# Work around UI glitch in Wasabi by presetting the screen resolution
xrandr --output screen --mode 1920x1080

wassabee
